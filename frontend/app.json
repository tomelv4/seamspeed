{
  "expo": {
    "name": "PACED",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101312",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.seamspeed.vajl9h",
      "infoPlist": {
        "NSCameraUsageDescription": "Film your deliveries for AI bowling analysis",
        "NSMicrophoneUsageDescription": "Record audio with your bowling clips",
        "NSPhotoLibraryUsageDescription": "Upload bowling clips from your library"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.seamspeed.vajl9h",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#101312"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Upload bowling clips from your library",
          "cameraPermission": "Film your deliveries for AI bowling analysis",
          "microphonePermission": "Record audio with your bowling clips"
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-video",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Film each ball for live AI coaching",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
